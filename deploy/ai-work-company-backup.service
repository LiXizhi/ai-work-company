[Unit]
Description=Verified AI Work Company SQLite backup
After=ai-work-company.service
[Service]
Type=oneshot
User=awc
Group=awc
UMask=0077
ExecStart=/bin/sh /opt/ai-work-company/current/deploy/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-work-company
