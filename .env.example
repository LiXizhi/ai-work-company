AWC_HOST=127.0.0.1
AWC_PORT=8787
AWC_DB=data/company.sqlite
# Logical identifiers; never treated as provider attestations.
AWC_MODELS=claude-opus-5.5,gpt-6-astra

# Optional operator console: export an independently generated 32–512 character
# AWC_ADMIN_TOKEN to the server process. No default; never share with Workers.
# See docs/admin-console.md. The server does not load .env automatically.
